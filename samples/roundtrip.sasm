stage {
  var result = 0
  var power = 0
  var label = "001"
  list values = []
  broadcast ready = "ready"
}

sprite "Calculator" {
  sprite var count = 0
  state x=45 y=-20 direction=90 size=80 visible=true layer=1
  costume "Tile" 80x80 center 40,40 {
    rect 4,4 72,72 fill="#25875f"
    line 20,40 60,40 stroke="#ffffff" width=6
    line 40,20 40,60 stroke="#ffffff" width=6
  }

  proc accumulate(n: num):
    local var next = n + 1
    result += next
    values.add next

  @greenflag:
    result = 0
    values.delete_all
    power = 2 ^ 8
    repeat 3:
      call accumulate(4)
    count = sin(30) * 2
    result += round(count)
    event.broadcast ready
}
